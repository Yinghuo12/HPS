syntax = "proto3";
package ddt;

import "common.proto";
import "login.proto";
import "chat.proto";
import "room.proto";

// ---- 回合 ----
message TurnStartNotify {
  uint32 turn_player_id = 1;
  float  wind           = 2;
  uint32 turn_number    = 3;
}

// ---- 射击 ----
message ShootRequest {
  int32  angle = 1;
  double force = 2;
}

message ShootResultNotify {
  uint32           shooter_id      = 1;
  int32            angle           = 2;
  double           force           = 3;
  float            wind            = 4;
  repeated TrajectoryPoint points  = 5;
  float            hit_x           = 6;
  float            hit_y           = 7;
  bool             hit_player      = 8;
  uint32           hit_player_id   = 9;
  int32            damage          = 10;
  PlayerState      updated_player1 = 11;
  PlayerState      updated_player2 = 12;
}

// ---- 移动 ----
message MoveRequest {
  float delta_x = 1;
}

message MoveNotify {
  uint32 player_id = 1;
  float  new_x     = 2;
}

// ---- 游戏结束 ----
message GameOverNotify {
  uint32 winner_id = 1;
  string reason    = 2;
}

// ---- 杂项 ----
message OpponentLeftNotify {
  uint32 player_id = 1;
}

// ---- 顶层消息 ----
message GameMessage {
  oneof payload {
    // 登录 (1-2)
    LoginRequest       login_request       = 1;
    LoginResponse      login_response      = 2;
    // 房间 (3-5)
    JoinRoomRequest    join_room_request   = 3;
    JoinRoomResponse   join_room_response  = 4;
    RoomReadyNotify    room_ready_notify   = 5;
    // 战斗 (6-13)
    TurnStartNotify    turn_start_notify   = 6;
    ShootRequest       shoot_request       = 7;
    ShootResultNotify  shoot_result_notify = 8;
    GameOverNotify     game_over_notify    = 9;
    MoveRequest        move_request        = 10;
    MoveNotify         move_notify         = 11;
    ErrorNotify        error_notify        = 12;
    OpponentLeftNotify opponent_left_notify = 13;
    // 账号 + 聊天 (20-30)
    RegisterRequest    register_request    = 20;
    RegisterResponse   register_response   = 21;
    ChatRequest        chat_request        = 22;
    ChatNotify         chat_notify         = 23;
    ChatHistoryRequest chat_history_request = 24;
    ChatHistoryResponse chat_history_response = 25;
    FriendAddRequest   friend_add_request  = 26;
    FriendAddResponse  friend_add_response = 27;
    FriendListRequest  friend_list_request = 28;
    FriendListResponse friend_list_response = 29;
    PrivateChatRequest private_chat_request = 30;
    // 房间管理 (31-40)
    RoomListRequest    room_list_request    = 31;
    RoomListResponse   room_list_response   = 32;
    CreateRoomRequest  create_room_request  = 33;
    CreateRoomResponse create_room_response = 34;
    RoomUpdateNotify   room_update_notify   = 35;
    ReadyRequest       ready_request        = 36;
    ReadyNotify        ready_notify         = 37;
    LeaveRoomRequest   leave_room_request   = 38;
    SwitchTeamRequest  switch_team_request  = 39;
    SwitchTeamResponse switch_team_response = 40;
  }
}
