# Build output
build/
packaging/dist/

# Compiled binaries and libraries
# bin/ 仅保留运行时配置 (conf/) 与资源，忽略全部编译产物 / core dump / 数据文件
bin/*
!bin/conf/
bin/conf/*.txt
bin/core
lib/*.a
lib/*.so
lib/libetcd_close_fix.so
*.o

# Bundled third-party header deps — too large, install via system packages
# boost: sudo apt install libboost-all-dev
# yaml-cpp: sudo apt install libyaml-cpp-dev
thirdparty/include/boost/
thirdparty/include/yaml-cpp/

# Thirdparty git dirs (keep source, remove .git)
thirdparty/*/.git/

# IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store

# Logs
logs/
*.log
